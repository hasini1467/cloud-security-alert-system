# ==============================================================================
# Cloud Security Alert System - Environment Configuration
# ==============================================================================

# AWS Region (e.g. ap-south-1, us-east-1)
AWS_REGION=ap-south-1

# Optional AWS Credentials for Backend Container to invoke Lambda
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Name of the AWS Lambda Security Scanner function
LAMBDA_FUNCTION_NAME=s3-security-scanner

# AWS IoT Core ATS Endpoint (e.g., a3xxxxxxxxxxxx-ats.iot.ap-south-1.amazonaws.com)
AWS_IOT_ENDPOINT=

# MQTT Topic for Security Telemetry
MQTT_TOPIC=s3/security/status

# Amazon SNS Alert Topic ARN
SNS_TOPIC_ARN=

# Alert Email Address for Notifications
ALERT_EMAIL=

# Operating Mode:
# 'true'  -> Laptop-only simulation mode (works offline without any AWS account or costs)
# 'false' -> Connects to live AWS Lambda and AWS IoT Core MQTT broker
SIMULATION_MODE=true
